{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "permissions": {
    "allow": [
      "Bash(npm run test:*)",
      "Bash(git diff:*)",
      "PowerShell(Get-ChildItem *)",
      "Read(./src/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./secrets/**)",
      "Bash(curl:*)"
    ],
    "defaultMode": "acceptEdits"
  },
  "cleanupPeriodDays": 30,
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Users\\张三\\My Tools\\.venv\\Scripts\\python.exe",
            "args": [
              "-I",
              "-S",
              "C:\\Users\\张三\\My Tools\\boundkeep\\src\\boundkeep\\hook_client.py",
              "prompt"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Users\\张三\\My Tools\\.venv\\Scripts\\python.exe",
            "args": [
              "-I",
              "-S",
              "C:\\Users\\张三\\My Tools\\boundkeep\\src\\boundkeep\\hook_client.py",
              "pre"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "WebFetch|WebSearch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Users\\张三\\My Tools\\.venv\\Scripts\\python.exe",
            "args": [
              "-I",
              "-S",
              "C:\\Users\\张三\\My Tools\\boundkeep\\src\\boundkeep\\hook_client.py",
              "post"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Users\\张三\\My Tools\\.venv\\Scripts\\python.exe",
            "args": [
              "-I",
              "-S",
              "C:\\Users\\张三\\My Tools\\boundkeep\\src\\boundkeep\\hook_client.py",
              "config"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
