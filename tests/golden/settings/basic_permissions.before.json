{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "permissions": {
    "allow": [
      "Bash(npm run test:*)",
      "Bash(git diff:*)",
      "PowerShell(Get-ChildItem *)",
      "Read(./src/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./secrets/**)",
      "Bash(curl:*)"
    ],
    "defaultMode": "acceptEdits"
  },
  "cleanupPeriodDays": 30
}
