{
  "model": "opus",
  "env": {
    "项目名称": "守界 ✓",
    "PROJECT_DIR": "D:\\项目\\我的 应用",
    "GREETING": "你好，世界 😀"
  },
  "permissions": {
    "allow": [
      "Read(./文档/**)",
      "PowerShell(Get-Content 说明.txt)"
    ],
    "deny": [
      "Read(./私密/**)"
    ]
  },
  "companyAnnouncements": [
    "欢迎使用 Claude Code",
    "请先阅读 README"
  ],
  "outputStyle": "简洁",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Users\\张三\\My Tools\\.venv\\Scripts\\python.exe",
            "args": [
              "-I",
              "-S",
              "C:\\Users\\张三\\My Tools\\boundkeep\\src\\boundkeep\\hook_client.py",
              "prompt"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Users\\张三\\My Tools\\.venv\\Scripts\\python.exe",
            "args": [
              "-I",
              "-S",
              "C:\\Users\\张三\\My Tools\\boundkeep\\src\\boundkeep\\hook_client.py",
              "pre"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "WebFetch|WebSearch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Users\\张三\\My Tools\\.venv\\Scripts\\python.exe",
            "args": [
              "-I",
              "-S",
              "C:\\Users\\张三\\My Tools\\boundkeep\\src\\boundkeep\\hook_client.py",
              "post"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Users\\张三\\My Tools\\.venv\\Scripts\\python.exe",
            "args": [
              "-I",
              "-S",
              "C:\\Users\\张三\\My Tools\\boundkeep\\src\\boundkeep\\hook_client.py",
              "config"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
