{
  "model": "opus",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Users\\张三\\My Tools\\.venv\\Scripts\\python.exe",
            "args": [
              "-I",
              "-S",
              "C:\\Users\\张三\\My Tools\\boundkeep\\src\\boundkeep\\hook_client.py",
              "prompt"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo user-hook-before"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Users\\张三\\My Tools\\.venv\\Scripts\\python.exe",
            "args": [
              "-I",
              "-S",
              "C:\\Users\\张三\\My Tools\\boundkeep\\src\\boundkeep\\hook_client.py",
              "pre"
            ],
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "echo user-hook-after"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "echo user-post-hook"
          }
        ]
      },
      {
        "matcher": "WebFetch|WebSearch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Users\\张三\\My Tools\\.venv\\Scripts\\python.exe",
            "args": [
              "-I",
              "-S",
              "C:\\Users\\张三\\My Tools\\boundkeep\\src\\boundkeep\\hook_client.py",
              "post"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Users\\张三\\My Tools\\.venv\\Scripts\\python.exe",
            "args": [
              "-I",
              "-S",
              "C:\\Users\\张三\\My Tools\\boundkeep\\src\\boundkeep\\hook_client.py",
              "config"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
